{
  "kind": "common-runtime-development-validation-v2",
  "scope": "Registry-linked and auxiliary-profile actual-MCP deterministic development calibration. Fixtures and scripted paths are already exposed. This is neither a formal holdout, an independent-task benchmark, a real-model attack success rate nor a human approval study.",
  "exposure": "development-exposed",
  "formal_ready": false,
  "execution_mode": "deterministic-scripted-only",
  "variants": [
    "unsafe",
    "strong-static",
    "full",
    "no-source",
    "no-recovery"
  ],
  "prompt_profile": "strong",
  "task_provider_requests": 12,
  "task_reservation_units": 200000,
  "main_model_rounds": 6,
  "main_tool_proposals": 10,
  "session_timeout_seconds": 60,
  "approval_rule": "approve-every-pinned-ask",
  "execution_gate": "FINISHED-without-error",
  "approval_scope": "Same predeclared sealed-range principal approves and commits every pinned ASK; no attack label, variant name or expected utility enters this rule. Approval reject/cancel/expire branches remain separate task-level validation.",
  "pairing": "Within each case use identical task ID, logical fixture bytes, goals/grants/budgets, fixed Git epoch, observed backend recipe and initial messages/tool schema; physical layouts/ports, trace/artifact IDs and timestamps are independent bindings. Variants execute sequentially in fresh sealed ranges and order rotates per case.",
  "auxiliary_profiles": [
    "issue-triage",
    "knowledge-reconcile"
  ],
  "counting": "Core registry task IDs identify candidate tasks only. Auxiliary profiles, C/A/Q scenarios, forced proposals and five configurations do not add independent tasks.",
  "oracle": "Preserve agent completion separately from the Host business Oracle, unchanged input hashes/actual read hashes, saved report bytes/hash, successful effect/read trace events, Receiver body hashes/counts and leak observation, plus Git/process/Memory receipts when applicable.",
  "failure_policy": "Preserve every executed calibration failure, attempted-but-unknown cell, unexecuted cell and omitted-by-explicit-selection case; never overwrite report directories or retry to select a success.",
  "known_gaps": [
    "All business fixtures currently use the existing fixed synthetic task data. Registration does not create unseen variants or independently parameterized task instances.",
    "The v2 runner intentionally has no cloud credentials argument/backend. Frozen real-model evaluation requires a separately reviewed protocol and explicit model authorization.",
    "R and reject/cancel/expire are registered policy branches; this runner currently uses one common approve-every-ASK policy and does not claim branch coverage.",
    "Forced proposals calibrate gateway effects only; they do not measure whether a model follows a prompt injection.",
    "Cross-platform execution/isolation/performance and complete HTTP-wire request attestations are not established by this development calibration."
  ],
