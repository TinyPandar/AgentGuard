digraph provenance {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.6, bgcolor="white", labelloc=t, label="Attack-path DAG (red = reconstructed path of the focused decision)"];
  node [fontname="Helvetica", fontsize=10, style="rounded,filled", shape=box];
  edge [fontname="Helvetica", fontsize=8, color="#94a3b8", fontcolor="#64748b"];
  subgraph "cluster_agent:0" {
    label="main-agent lane"; style="rounded,dashed"; color="#86efac"; fontcolor="#15803d";
