ARG SUJIE_PYTHON_BASE=python:3.12-slim
FROM ${SUJIE_PYTHON_BASE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/demo-agent
WORKDIR /app

COPY requirements.lock /app/requirements.lock
COPY deploy/wheelhouse /wheelhouse
ARG SUJIE_OFFLINE_BUILD=0
RUN if [ "$SUJIE_OFFLINE_BUILD" = "1" ]; then \
      python -m pip install --no-cache-dir --no-index --find-links=/wheelhouse \
        -r /app/requirements.lock; \
    else \
      python -m pip install --no-cache-dir -r /app/requirements.lock; \
    fi \
    && rm -rf /wheelhouse
COPY demo-agent /app/demo-agent
RUN chmod -R a=rX /app/demo-agent

USER 65532:65532
CMD ["python", "/app/demo-agent/run_container_demo.py"]
