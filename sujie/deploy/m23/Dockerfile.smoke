ARG DEPENDENCY_IMAGE=sujie-m23-smoke-base:20261017-py31214
FROM ${DEPENDENCY_IMAGE}
LABEL org.sujie.purpose="m23-linux-smoke" org.sujie.ownership="m23-20261017-smoke"
COPY --chown=0:0 sujie /app/sujie
COPY --chown=0:0 context-manifest.json /app/context-manifest.json
ENV HOME=/tmp TMPDIR=/tmp PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false
USER 10001:10001
WORKDIR /app/sujie
ENTRYPOINT ["python", "deploy/m23/smoke.py"]
